    "@remotion/bundler": "^4.0.543",
    "@remotion/renderer": "^4.0.543",
    "dotenv": "^16.4.5",
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
